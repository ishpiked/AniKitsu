# Copy to your hosting provider's environment variables (Vercel → Project
# Settings → Environment Variables, or your own server's env). Never commit
# real values. All of these are server-only: nothing here is exposed to the
# browser or the public status page.

# Stable base URL of the Kitsu FastAPI backend. Do not use an ephemeral tunnel.
KITSU_API_URL=https://your-stable-backend.example.com

# Telegram bot username linked to this website domain through BotFather.
KITSU_TELEGRAM_BOT_USERNAME=AniKitsuBot

# HMAC secret signing operator session cookies (32 random bytes,
# hex-encoded). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be identical on every instance, otherwise sessions break.
DASHBOARD_SESSION_SECRET=change-me-to-32-random-bytes-hex

# Signed Telegram profile session lifetime in seconds (optional, default 43200 = 12h).
DASHBOARD_SESSION_TTL_SECONDS=43200
# Owner bearer token for the backend /api/admin/v1 and /api/owner namespaces.
# Forwarded server-side only, never to the browser. Must match the backend's
# OWNER_API_TOKEN. Required for the owner dashboard.
KITSU_OWNER_API_TOKEN=

# Canonical public URL of this deployment, used for sitemap, robots,
# canonical links, Open Graph images, and structured data.
# This one is public by design (it is your own domain). No trailing slash.
# Example: NEXT_PUBLIC_SITE_URL=https://anikitsu.vercel.app
# On Vercel you may skip it: VERCEL_URL is used automatically as fallback.
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com
