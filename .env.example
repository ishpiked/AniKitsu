# Copy to your hosting provider's environment variables (Vercel → Project
# Settings → Environment Variables, or your own server's env). Never commit
# real values. Secrets are server-only; the public bot username is exposed
# only to the sign-in page so Telegram can render its Login Widget.

# Base URL of the Kitsu FastAPI backend (no trailing slash).
KITSU_API_URL=https://your-backend.example.com

# Bot token used only on the server to verify signed Telegram login data.
# Must belong to the same bot that launches this app. Never expose it to clients.
KITSU_BOT_TOKEN=

# Public bot username used to render the Telegram Login Widget (without @).
# The app defaults to AniKitsuBot if this override is omitted.
KITSU_BOT_USERNAME=AniKitsuBot

# Telegram user ID of the bot owner; keep this aligned with the backend's
# OWNER_USER_ID. Only this verified account can enter /dev.
KITSU_OWNER_USER_ID=7818848697

# HMAC secret signing verified Telegram user session cookies (32 random bytes,
# hex-encoded). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be identical on every instance, otherwise sessions break.
DASHBOARD_SESSION_SECRET=change-me-to-32-random-bytes-hex

# Session lifetime in seconds (optional, default 43200 = 12h).
DASHBOARD_SESSION_TTL_SECONDS=43200
# Owner bearer token for the backend /api/admin/v1 and /api/owner namespaces.
# Forwarded server-side only, never to the browser. Must match the backend's
# OWNER_API_TOKEN. Required for the owner dashboard and personal profile data.
KITSU_OWNER_API_TOKEN=

# Canonical public URL of this deployment, used for sitemap, robots,
# canonical links, Open Graph images, and structured data.
# This one is public by design (it is your own domain). No trailing slash.
# Example: NEXT_PUBLIC_SITE_URL=https://anikitsu.vercel.app
# On Vercel you may skip it: VERCEL_URL is used automatically as fallback.
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com
